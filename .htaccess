# Berel - sitio estático (Apache / cPanel)
DirectoryIndex index.html
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # === Forzar HTTPS ===
  # El sitio va detrás de nginx (proxy) que termina el SSL, por eso se usa
  # X-Forwarded-Proto en lugar de %{HTTPS} (que Apache vería siempre "off"
  # y provocaría un bucle de redirección).
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Rutas "bonitas": servir carpeta/index.html sin barra final
  # si el archivo o carpeta existe, servir tal cual
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  # /ruta -> /ruta/index.html si existe
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.+?)/?$ /$1/index.html [L]
</IfModule>

# Compresión (Apache). NOTA: si nginx sirve los estáticos directo, esto no
# aplica y hay que activar gzip/brotli en la config de nginx del hosting.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml font/woff2
</IfModule>

# Cabeceras de caché explícitas (surten efecto si Apache sirve el archivo)
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2|webp|png|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Caché de assets con hash (inmutables)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
