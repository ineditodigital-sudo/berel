# Administradores autorizados, separados por coma.
ADMIN_EMAILS=ineditodigital@gmail.com
# Abre /admin sin iniciar sesión. Solo surte efecto si además
# NODE_ENV === "development", así que una fuga a producción no expone el CMS.
ADMIN_PREVIEW=false

# Mercado Pago Checkout Pro. Mantén el token únicamente como secreto.
MERCADO_PAGO_ACCESS_TOKEN=

# Correos transaccionales de pedidos.
RESEND_API_KEY=
ORDER_EMAIL_FROM=Berel Pedidos <pedidos@tu-dominio.com>

# Solo para los scripts manuales de FTP; no se usan en Sites.
BEREL_FTP_HOST=
BEREL_FTP_USER=
BEREL_FTP_PASSWORD=
BEREL_FTP_REMOTE=/public_html/berel.inedito.digital
